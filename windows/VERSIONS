# Pinned upstream inputs for the Windows installer (build.ps1 verifies them before use).
# wstunnel is built from source: Smart App Control blocks the official v11.1.0 Windows binary and
# Defender quarantines it (see README). The commit is what the v11.1.0 tag points at.
# ring instead of the default aws-lc-rs: no cmake/nasm needed. Upstream tests this feature set in CI.
WSTUNNEL_VERSION=v11.1.0
WSTUNNEL_GIT_URL=https://github.com/erebe/wstunnel.git
WSTUNNEL_COMMIT=d1bc22c48a26f29d87d2c8de1d09a018e602b7fa
WSTUNNEL_CARGO_FEATURES=ring
WSTUNNEL_RUST_TOOLCHAIN=1.99.1
# WireGuard for Windows: https://download.wireguard.com/windows-client/
# Authenticode signer confirmed as "WireGuard LLC" (Get-AuthenticodeSignature, Status Valid).
WIREGUARD_VERSION=1.1.1
WIREGUARD_URL=https://download.wireguard.com/windows-client/wireguard-amd64-1.1.1.msi
WIREGUARD_SHA256_AMD64=7bfed60ad61b785c914b38b61555a975488e1d3ec472dbfb2fcdf498fca75242
# This project (installer file name)
WGVPN_VERSION=0.1.0
